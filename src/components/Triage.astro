---
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';
import emergencies from '../data/emergencies.json';
import { biz, gasTelHref, money, priceRange } from '../lib/business';

const gas = biz.gasUtility;
const visitFee = money(biz.pricing.afterHoursVisitFee);
const items = emergencies.map((e) => ({
  id: e.id as 'leak' | 'sewer' | 'heater',
  title: e.title,
  rightNow: e.rightNow,
  range: priceRange(biz.pricing.emergencies[e.id as 'leak' | 'sewer' | 'heater']),
}));
---
<div class="triage" data-triage>
  <h2 id="triage-h">What's happening right now?</h2>
  <p class="gasline"><strong>Smell gas? Leave first,</strong> then call {gas.name} at <a href={gasTelHref} class="num">{gas.phone}</a> or 911.</p>
  <fieldset class="options">
    <legend class="sr-only">What's happening? Pick one.</legend>
    {items.map((i) => (
      <label class="opt">
        <input type="radio" name="triage" id={`t-${i.id}`} value={i.id} />
        <span class="face"><Icon name={i.id} /><span>{i.title}</span></span>
      </label>
    ))}
  </fieldset>
  <p class="hint">Pick the one that fits. Not sure? Just call.</p>
  <div class="answers">
    {items.map((i) => (
      <div class="answer" id={`ta-${i.id}`}>
        <div class="figs">
          <div><p class="sub">Typical price range</p><p class="range">{i.range}</p></div>
          <div><p class="sub">Visit fee</p><p class="fee">{visitFee}, credited toward the job</p></div>
        </div>
        <p class="now"><strong>Do this now:</strong> {i.rightNow}</p>
        <div class="acts">
          <CallButton large primary label="Call" />
          <a class="textlink" href={`#card-${i.id}`} data-open={`card-${i.id}`}>See the full steps</a>
        </div>
      </div>
    ))}
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-status></p>
</div>
<style>
  .triage{display:flex;flex-direction:column;gap:18px}
  .gasline{padding:12px 16px;border-left:4px solid var(--alert);background:var(--alert-bg);font-size:17px;line-height:1.5;border-radius:0 12px 12px 0}
  .num{font-weight:700;white-space:nowrap}
  .options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;border:0;padding:0;margin:0}
  .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .opt{position:relative;display:block;cursor:pointer}
  .opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
  .face{display:flex;flex-direction:row;align-items:center;gap:14px;min-height:88px;padding:14px 18px;background:var(--surface-raised);border:2px solid var(--line);border-radius:18px;font:700 20px/1.2 var(--font-head)}
  .opt:hover .face{border-color:var(--accent)}
  .opt input:checked + .face{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--surface-raised))}
  .opt input:focus-visible + .face{outline:3px solid var(--accent);outline-offset:3px}
  .hint{color:var(--ink-mute)}
  .answers{display:contents}
  .answer{display:flex;flex-direction:column;gap:16px;padding:24px;background:var(--surface-raised);border:1px solid var(--line);border-top:4px solid var(--accent);border-radius:18px}
  .figs{display:flex;flex-wrap:wrap;gap:12px 40px}
  .range{font:400 clamp(34px,6vw,44px)/1.05 var(--font-head)}
  .fee{font-weight:600;line-height:1.4;padding-top:6px}
  .now{font-size:19px}
  .acts{display:flex;flex-wrap:wrap;align-items:center;gap:4px 24px}
  .acts :global(.btn){flex:0 1 auto}
  /* With CSS :has() support, show only the chosen answer and hide the hint once one is picked.
     Without it, all three answers stay visible and nothing is lost. */
  @supports selector(:has(*)){
    .answer{display:none}
    .triage:has(#t-leak:checked) #ta-leak,
    .triage:has(#t-sewer:checked) #ta-sewer,
    .triage:has(#t-heater:checked) #ta-heater{display:flex}
    .triage:has(input:checked) .hint{display:none}
  }
  @media (max-width:760px){
    .options{grid-template-columns:minmax(0,1fr)}
    .face{min-height:72px}
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-triage]');
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    root.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'triage') return;
      const a = root.querySelector<HTMLElement>(`#ta-${input.value}`);
      if (!a) return;
      const label = input.closest('label')?.textContent?.trim() ?? '';
      const range = a.querySelector('.range')?.textContent ?? '';
      const fee = a.querySelector('.fee')?.textContent ?? '';
      const now = a.querySelector('.now')?.textContent ?? '';
      status.textContent = `${label}. Typical price range ${range}. Visit fee ${fee}. ${now.replace(/\.$/, "")}. A call button follows.`;
    });
    // "See the full steps" opens the matching card below.
    root.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-open]');
      if (!link) return;
      const d = document.getElementById(link.dataset.open!) as HTMLDetailsElement | null;
      if (d) d.open = true;
    });
  }
</script>
