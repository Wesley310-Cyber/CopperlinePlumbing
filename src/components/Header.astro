---
import CallButton from './CallButton.astro';
import { biz } from '../lib/business';
---
<header class="site-header">
  <div class="wrap">
    <span class="logo">{biz.wordmark.primary.toUpperCase()}</span>
    <p class="mob tagline">24/7 emergency plumbing. A real person answers.</p>
    <nav class="dsk" aria-label="Sections">
      <a href="#triage">Emergencies</a><a href="#price">Pricing</a><a href="#family">Family</a><a href="#area">Area</a><a href="#callback">Callback</a>
    </nav>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Night mode" title="Night mode">
      <svg class="moon" viewBox="0 0 48 48" aria-hidden="true"><path d="M38 28A16 16 0 0 1 20 10a16 16 0 1 0 18 18z"></path></svg>
      <svg class="sun" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="8"></circle><path d="M24 6v6M24 36v6M6 24h6M36 24h6M11 11l4 4M33 33l4 4M37 11l-4 4M15 33l-4 4"></path></svg>
    </button>
    <CallButton class="dsk header-call" label="Call" />
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const sync = () => {
    const night = root.getAttribute('data-theme') === 'night';
    btn?.setAttribute('aria-pressed', String(night));
    btn?.setAttribute('aria-label', night ? 'Night mode, on. Switch to day mode' : 'Night mode, off. Switch to night mode');
    btn?.setAttribute('title', night ? 'Switch to day mode' : 'Switch to night mode');
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'night' ? 'day' : 'night';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('copperline-theme', next); } catch {}
    sync();
  });
</script>
<style>
  .site-header{background:var(--surface);border-bottom:1px solid var(--line)}
  .wrap{display:flex;align-items:center;gap:12px;padding-top:8px;padding-bottom:8px}
  .logo{font:600 24px var(--font-head);letter-spacing:.08em;flex:none}
  .theme-toggle{display:none;flex:none;margin-left:auto;width:var(--tap);height:var(--tap);align-items:center;justify-content:center;background:transparent;color:var(--ink);border:2px solid var(--line);border-radius:14px;cursor:pointer}
  :global(.js) .theme-toggle{display:inline-flex}
  .theme-toggle:hover{border-color:var(--accent);color:var(--accent)}
  .theme-toggle svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .sun{display:none}
  :global([data-theme="night"]) .sun{display:block}
  :global([data-theme="night"]) .moon{display:none}
  nav + .theme-toggle{margin-left:0}
  @media (max-width:420px){.tagline{display:none}}
  .tagline{flex:1;font-size:12px;line-height:1.25;font-weight:600}
  nav{display:flex;gap:20px;flex:1;justify-content:center}
  nav a{display:inline-flex;align-items:center;min-height:var(--tap);text-decoration:none;font-weight:600;font-size:13px;letter-spacing:.12em;text-transform:uppercase}
  nav a:hover{text-decoration:underline;text-decoration-color:var(--accent);text-decoration-thickness:2px;text-underline-offset:6px}
</style>
