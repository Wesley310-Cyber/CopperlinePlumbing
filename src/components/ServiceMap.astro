---
import { biz, cities } from '../lib/business';
const [z1, z2, z3] = biz.pricing.zones;
const label = (s: string) => s.toUpperCase();
// Positions are schematic. Every name must also appear in business.json serviceArea.cities.
const places = [
  { name: 'Altadena', x: 296, y: 236, tx: 306, ty: 232, end: false },
  { name: 'Arcadia', x: 352, y: 288, tx: 362, ty: 294, end: false },
  { name: 'Alhambra', x: 270, y: 340, tx: 260, ty: 346, end: true },
  { name: 'West Covina', x: 344, y: 352, tx: 354, ty: 358, end: false },
].filter((p) => cities.some((c) => c.name === p.name));
---
<figure>
  <svg class="map" viewBox="0 0 560 560" role="img" aria-label={`Schematic map: ${z1.name} around ${biz.address.city}, ${z2.name} beyond it, ${z3.name} out to ${biz.pricing.maxTravelMiles} miles.`}>
    <circle cx="280" cy="280" r="262" class="ring r3" data-zone="3"></circle>
    <circle cx="280" cy="280" r="178" class="ring r2" data-zone="2"></circle>
    <circle cx="280" cy="280" r="98" class="ring r1" data-zone="1"></circle>
    <circle cx="280" cy="280" r="98" class="hl" data-hl></circle>
    <g class="zone-label"><text x="280" y="528" data-zone="3">{label(z3.name)} · UP TO {biz.pricing.maxTravelMiles} MILES</text><text x="280" y="436" data-zone="2">{label(z2.name)}</text><text x="280" y="392" data-zone="1">{label(z1.name)}</text></g>
    <g class="pin">{places.map((p) => <circle cx={p.x} cy={p.y} r="5"></circle>)}</g>
    <g class="city">{places.map((p) => <text x={p.tx} y={p.ty} text-anchor={p.end ? 'end' : 'start'}>{p.name}</text>)}</g>
    <circle cx="280" cy="280" r="10" class="hub"></circle>
    <text x="280" y="262" class="shop">{biz.address.city} shop</text>
  </svg>
  <figcaption class="small">Schematic map, not to scale.</figcaption>
</figure>
<style>
  figure{margin:0;background:var(--panel-deep);padding:16px;border:1px solid var(--line-on-teal);border-radius:4px}
  svg{width:100%;height:auto;display:block}
  .ring{fill:var(--panel-accent);stroke:var(--panel-accent);stroke-width:2;stroke-dasharray:8 6}
  .r3{fill-opacity:.06;stroke-opacity:.7}
  .r2{fill-opacity:.12;stroke-opacity:.8}
  .r1{fill-opacity:.3;stroke:var(--panel-accent);stroke-width:2.5;stroke-dasharray:none;stroke-opacity:1}
  .hl{fill:none;stroke:var(--panel-ink);stroke-width:5;stroke-linecap:round;opacity:0}
  .zone-label{font-size:20px;font-weight:600;letter-spacing:2px;text-anchor:middle;fill:var(--panel-ink)}
  .pin{fill:var(--panel-ink)}
  .city{font-size:20px;fill:var(--panel-mute)}
  .hub{fill:var(--panel-accent)}
  .shop{text-anchor:middle;font-size:22px;font-weight:600;fill:var(--panel-ink)}
  figcaption{color:var(--panel-mute);padding-top:10px}
  /* When a city is found, its zone stays lit and the others step back. */
  .map[data-active] .ring{fill-opacity:.05;stroke-opacity:.35}
  .map[data-active] .zone-label text{opacity:.45}
  .map[data-active="1"] .r1,.map[data-active="2"] .r2,.map[data-active="3"] .r3{fill-opacity:.32;stroke-opacity:1}
  .map[data-active="1"] [data-zone="1"],.map[data-active="2"] [data-zone="2"],.map[data-active="3"] [data-zone="3"]{opacity:1}
  @media (prefers-reduced-motion:no-preference){
    .ring,.zone-label text{transition:fill-opacity .4s ease,stroke-opacity .4s ease,opacity .4s ease}
  }
</style>
