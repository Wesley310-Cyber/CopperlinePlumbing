---
import { biz, onCallReady } from '../lib/business';
const { onCall } = biz;
---
{onCallReady && (
  <p class="status"><span class="dot" aria-hidden="true"></span>On call tonight: <strong>{onCall.name}</strong> — typical arrival {onCall.arrivalWindow} in the {onCall.region}.</p>
)}
<style>
  .status{background:var(--panel);color:var(--panel-ink);font-size:13px;line-height:1.35;padding:8px 16px;text-align:center}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--accent);margin-right:10px}
  /* Night: the dot gives off a slow ring, once every few seconds. */
  @media (prefers-reduced-motion:no-preference){
    :global([data-theme="night"]) .dot{animation:pulse 3.2s ease-out infinite}
  }
  @keyframes pulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 60%,transparent)}70%,100%{box-shadow:0 0 0 10px transparent}}
</style>
